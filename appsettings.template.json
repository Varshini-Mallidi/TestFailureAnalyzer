{
  "AzureDevOps": {
    "OrganizationUrl": "https://dev.azure.com/YOUR-ORG",
    "ProjectName": "YOUR-PROJECT-NAME",
    "PersonalAccessToken": "YOUR-PAT-TOKEN-HERE",
    "Comment": "PAT requires scopes: Build (Read), Test Management (Read). Get PAT at: https://dev.azure.com/YOUR-ORG/_usersSettings/tokens",
    "DefaultPipelineId": 0,
    "TempDownloadPath": ".ado-downloads"
  },
  "AzureOpenAI": {
    "Endpoint": "https://YOUR-RESOURCE-NAME.openai.azure.com/",
    "ApiKey": "YOUR-API-KEY-HERE",
    "DeploymentName": "gpt-4o",
    "ApiVersion": "2024-02-01",
    "EmbeddingDeploymentName": "text-embedding-3-small",
    "MaxOutputTokens": 16384,
    "Comment": "GPT-4o supports up to 16,384 output tokens"
  },
  "OpenAI": {
    "ApiKey": "YOUR-OPENAI-API-KEY-HERE",
    "Model": "gpt-4o",
    "MaxOutputTokens": 16384,
    "Comment": "GPT-4o supports up to 16,384 output tokens"
  },
  "Gemini": {
    "ApiKey": "YOUR-GEMINI-API-KEY-HERE",
    "Model": "gemini-flash-latest",
    "MaxOutputTokens": 6000,
    "Comment": "Reduced from 8,192 to 6,000 to force more concise responses and reduce truncation. Get FREE API key at: https://aistudio.google.com/app/apikey"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "AnalysisModel": "llama3.1:latest",
    "MaxRetries": 3,
    "TimeoutSeconds": 300,
    "MaxOutputTokens": 4096,
    "Comment": "Local models vary - Llama 3.1 typically handles 4,096 tokens. Adjust based on your model."
  },
  "Vision": {
    "Enabled": true,
    "Provider": "Gemini",
    "MaxScreenshotsPerFailure": 3,
    "AzureDeploymentName": "gpt-4o",
    "OllamaModel": "qwen3.5",
    "Comment": "Vision AI for screenshot analysis. Providers: Gemini (FREE), Azure, OpenAI, Ollama (local). Recommended Ollama models: qwen3.5 (best for UI/OCR), llava, llava-phi3, bakllava"
  },
  "VectorStore": {
    "Provider": "Json",
    "Qdrant": {
      "Host": "localhost",
      "Port": 6334,
      "CollectionName": "test_failure_chunks",
      "MaxConcurrentWrites": 10,
      "ApiKey": ""
    },
    "Json": {
      "StoragePath": ".rag/vectors.json"
    }
  },
  "RAG": {
    "ChunkingStrategy": "MethodAware",
    "MaxChunkTokens": 1000,
    "ChunkOverlapTokens": 50,
    "EnableIncrementalIndexing": true,
    "EmbeddingBatchSize": 100,
    "TopKResults": 8,
    "MinSimilarityScore": 0.5,
    "EnableHybridSearch": true,
    "KeywordWeight": 0.3,
    "SemanticWeight": 0.7,
    "StackTraceFileBoost": 1.5
  },
  "Analyzer": {
    "MaxFailuresToAnalyze": 15,
    "MaxLogChunkTokens": 6000,
    "MaxRetries": 3,
    "RetryDelayMs": 1000
  },
  "Pipeline": {
    "MaxConcurrentJobs": 1,
    "MaxRetries": 3,
    "RetryDelayMs": 1000,
    "EnableCheckpointing": true,
    "CheckpointDirectory": ".pipeline/checkpoints",
    "QueueDirectory": ".pipeline/queue",
    "JobTimeoutMinutes": 60,
    "EmbeddingBatchSize": 100,
    "EmbeddingRateLimitPerMinute": 1000,
    "ValidateChunks": true,
    "MinChunkSize": 50,
    "MaxChunkSize": 4000
  },
  "Monitoring": {
    "EnableHealthChecks": true,
    "EnableMetrics": true,
    "MetricRetentionMinutes": 60,
    "HealthCheckIntervalMinutes": 5
  }
}
